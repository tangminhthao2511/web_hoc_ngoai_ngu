# Copy to .env.production and fill in your existing Cloudflare deployment.
# Deploy: node --env-file=.env.production scripts/deploy.mjs
CLOUDFLARE_WORKER_NAME=
APP_ORIGIN=https://your-domain.example
D1_DATABASE_ID=
# Generate once with: openssl rand -base64 32
# Keep this value stable across deployments. An omitted value uses the
# existing secret on Cloudflare; a new Worker needs a value on first deploy.
BETTER_AUTH_SECRET=

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=demo
AI_MODEL=
AI_API_KEY=
