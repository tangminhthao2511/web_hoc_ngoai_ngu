{
  "name": "manabi-language-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm run typecheck && cf build",
    "preview": "vite preview",
    "typecheck": "cf workers types && tsc -b && tsc -p tsconfig.server.json",
    "deploy": "node scripts/deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 11111111-1111-4111-8111-111111111111 --local --persist-to .cloudflare/state --dir migrations",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "cf": "^1.0.0-rc.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^5.20261116.0-beta",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  }
}
